# ---- server ----
HOST=0.0.0.0
PORT=8080
NODE_ENV=production
LOG_LEVEL=info

# ---- storage ----
# memory | json | sqlite
STORE=sqlite
DATA_DIR=./data

# ---- embeddings ----
# hashing runs offline with no key; openai needs OPENAI_API_KEY
EMBEDDER=hashing
# OPENAI_API_KEY=sk-...
# OPENAI_EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSIONS=384

# ---- access ----
# Comma-separated origins, or * for any
CORS_ORIGINS=*
# Leave unset to run without authentication
# API_KEY=change-me
RATE_LIMIT_MAX=240
RATE_LIMIT_WINDOW_MS=60000
BODY_LIMIT_BYTES=1048576

# ---- behaviour ----
DEFAULT_NAMESPACE=default
# Run consolidation + maintenance on a timer. 0 disables.
MAINTENANCE_INTERVAL_MS=0
